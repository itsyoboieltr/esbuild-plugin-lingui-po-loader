{
  "name": "esbuild-plugin-lingui-po-loader",
  "version": "1.0.2",
  "description": "An esbuild plugin to load lingui catalogs from .po files.",
  "author": "Norbert Elter <norbert.elter0@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/itsyoboieltr/esbuild-plugin-lingui-po-loader#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsyoboieltr/esbuild-plugin-lingui-po-loader.git"
  },
  "bugs": "https://github.com/itsyoboieltr/esbuild-plugin-lingui-po-loader/issues",
  "keywords": [
    "esbuild-plugin",
    "lingui",
    "po"
  ],
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "check": "biome check ."
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/bun": "latest",
    "@biomejs/biome": "2.4.13"
  },
  "dependencies": {
    "@lingui/cli": "6.11.0"
  }
}
